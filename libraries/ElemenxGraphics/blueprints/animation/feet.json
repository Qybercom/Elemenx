			"x": 420,
			"y": 160,
			"properties": [
				{
					"key": "Expression",
					"value": "max(-MostDrop * Size, min(MostLift * Size, DownLeft - max(-MostDrop * Size, min(0, min(DownLeft, DownRight))))) * Grounded * (1 - 0.6 * smoothstep(RunFade * 0.6, RunFade, Speed))"
