{
	"version": 1,
	"type": "generator",
	"name": "animation-feet",
	"parameters": [
		{
			"key": "MostDrop",
			"type": "float",
			"value": 0.3,
			"comment": "Of its height, how far its hips go down at most for a foot to reach lower ground"
		},
		{
			"key": "MostLift",
			"type": "float",
			"value": 0.3,
			"comment": "Of its height, how far a foot goes up at most to higher ground"
		},
		{
			"key": "Rate",
			"type": "float",
			"value": 14,
			"comment": "How fast its feet and hips come to where they go (a part of the way each second)"
		},
		{
			"key": "RunFade",
			"type": "float",
			"value": 7,
			"comment": "Metres a second from which its feet keep to the ground less (a run lands where it lands)"
		}
	],
