				{
					"key": "Expression",
					"value": "min(MaxShake, Shake * (abs((Ax < 0 ? -1 : 1) * max(0, abs(Ax) * (1 - Compensation) - Threshold)) + abs((Ay < 0 ? -1 : 1) * max(0, abs(Ay) * (1 - Compensation) - Threshold)) + abs((Az < 0 ? -1 : 1) * max(0, abs(Az) * (1 - Compensation) - Threshold))) + TurnShake * abs(Turn) * (1 - Compensation) + HitShake * Hit + WarpShake * Warp) * (sin(Time * 19 + 2) * 0.5 + sin(Time * 43.89 + 8.6) * 0.3 + sin(Time * 98.23 + 18.2) * 0.2)"
