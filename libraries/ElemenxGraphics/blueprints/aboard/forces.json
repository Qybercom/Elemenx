				{
					"key": "Expression",
					"value": "max(-MaxPush, min(MaxPush, -(Ax < 0 ? -1 : 1) * max(0, abs(Ax) * (1 - Compensation) - Threshold) * Push + HitX * Hit * HitPush))"
