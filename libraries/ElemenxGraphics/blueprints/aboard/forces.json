			"x": 320,
			"y": 680,
			"properties": [
				{
					"key": "Expression",
					"value": "min(MaxShake, Shake * (abs((Ax < 0 ? -1 : 1) * max(0, abs(Ax) * (1 - Compensation) - Threshold)) + abs((Ay < 0 ? -1 : 1) * max(0, abs(Ay) * (1 - Compensation) - Threshold)) + abs((Az < 0 ? -1 : 1) * max(0, abs(Az) * (1 - Compensation) - Threshold))) + TurnShake * abs(Turn) * (1 - Compensation) + HitShake * Hit + WarpShake * Warp) * 0.6 * (sin(Time * 29 + 3) * 0.5 + sin(Time * 66.99 + 12.9) * 0.3 + sin(Time * 149.93 + 27.3) * 0.2)"
