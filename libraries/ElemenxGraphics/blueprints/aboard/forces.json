		{
			"key": "Compensation",
			"type": "float",
			"value": 0.9,
			"comment": "How much of how the ship speeds up and turns its artificial gravity takes away (1: none felt)"
		},
		{
			"key": "Threshold",
			"type": "float",
			"value": 2,
			"comment": "What is left of it under this (m/s²) is not felt at all"
		},
		{
			"key": "Push",
			"type": "float",
			"value": 0.35,
			"comment": "How fast what is felt carries the walker along the deck (m/s for each m/s²)"
		},
		{
