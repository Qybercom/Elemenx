			"key": "HitPush",
			"type": "float",
			"value": 2.5,
			"comment": "How far a hit throws the walker (m/s at its full)"
		},
		{
			"key": "WarpShake",
			"type": "float",
			"value": 0.012,
			"comment": "How much a way far at once (warp, jump) shakes the view"
		},
		{
			"key": "MaxShake",
			"type": "float",
			"value": 0.12,
			"comment": "The most the view shakes (radians)"
		}
	],
