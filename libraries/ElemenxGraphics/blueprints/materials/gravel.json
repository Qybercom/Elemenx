	"parameters": [],
	"blocks": [
		{
			"id": "pattern",
			"type": "GLSL",
			"x": 40,
			"y": 40,
			"properties": [
				{
					"key": "Code",
					"value": "\tfloat s = enx_ms(px, 0.012);\n\tvec4 g = enx_mc(q * 70.0, 1.0);\n\tfloat grain = smoothstep(0.5, 0.25, g.x) * s;\n\tvec3 tint = g.z < 0.25 ? vec3(1.25, 1.2, 1.12) : g.z < 0.45 ? vec3(1.1, 0.78, 0.62) : g.z < 0.7 ? vec3(0.78, 0.78, 0.8) : vec3(1.05, 0.92, 0.7);\n\tc *= mix(vec3(1.0), tint * (0.8 + g.w * 0.4), grain) * (0.9 + enx_mf(q * 2.0, 2) * 0.2);\n\th += grain * smoothstep(0.5, 0.0, g.x) * 0.004;\n\tr = 0.9;"
				},
				{
					"key": "Inputs",
					"value": "q: vec2, px: float"
				},
				{
					"key": "Outputs",
					"value": "c: vec3, r: float, m: float, h: float"
				},
				{
					"key": "Needs",
					"value": ""
				}
			],
			"comment": "Sandy gravel: grains of white, rust, grey and ochre in sand."
		}
	],
	"links": []
