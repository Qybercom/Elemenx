		{
			"id": "vehicles-body-formula-pitch",
			"type": "Formula",
			"x": 420,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "max(-MostPitch, min(MostPitch, Accel / 9.81 * PitchPerG / max(Stiff, 0.1))) * PI / 180 * Grounded"
				}
			]
		},
