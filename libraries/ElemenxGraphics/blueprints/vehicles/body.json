{
	"version": 1,
	"type": "generator",
	"name": "vehicles-body",
	"parameters": [
		{
			"key": "PitchPerG",
			"type": "float",
			"value": 1.2,
			"comment": "Degrees the body of a car pitches for each g it speeds up or brakes at (nose up speeding up, down braking)"
		},
		{
			"key": "RollPerG",
			"type": "float",
			"value": 2.5,
			"comment": "Degrees the body of a car rolls out of a turn for each g it turns at"
		},
		{
			"key": "MostPitch",
			"type": "float",
			"value": 4,
			"comment": "Degrees it pitches at most"
		},
		{
			"key": "MostRoll",
			"type": "float",
			"value": 6,
			"comment": "Degrees it rolls at most"
		},
		{
			"key": "Spring",
			"type": "float",
			"value": 45,
			"comment": "How hard its springs bring it to where it leans (per second squared)"
		},
		{
			"key": "Damp",
			"type": "float",
			"value": 0.55,
			"comment": "How much its dampers hold it (1: no swing past, less: a little swing)"
		}
	],
