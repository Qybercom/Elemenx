			"type": "Formula",
			"x": 420,
			"y": 160,
			"properties": [
				{
					"key": "Expression",
					"value": "max(-MostRoll, min(MostRoll, Lateral / 9.81 * RollPerG / max(Stiff, 0.1))) * PI / 180 * Grounded"
				}
			]
		},
