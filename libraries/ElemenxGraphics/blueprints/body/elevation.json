		{
			"id": "body-elevation-foldsat",
			"type": "Formula",
			"x": 300,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "vec3((PX * 2.2 + Seed) * 18 + 3, (PY * 2.2 + Seed * 0.7) * 18, (PZ * 2.2 + Seed * 1.3) * 18)"
				}
			]
		},
		{
			"id": "body-elevation-hillsat",
			"type": "Formula",
			"x": 580,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "vec3(PX * 260, PY * 260, PZ * 260)"
				}
			]
		},
		{
			"id": "body-elevation-bumpsat",
			"type": "Formula",
			"x": 860,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "vec3(PX * 2600, PY * 2600, PZ * 2600)"
				}
			]
		},
		{
			"id": "body-elevation-base",
			"type": "Formula",
			"x": 300,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "Ocean > 0 ? max(0, Value) * Height : (Value - 0.5) * Height"
				}
			]
		},
		{
			"id": "body-elevation-coast",
			"type": "Formula",
			"x": 580,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "saturate((Value - 0) / (0.05 - 0))"
				}
			]
		},
		{
			"id": "body-elevation-above",
			"type": "Formula",
			"x": 860,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "Ocean > 0 ? Coast * Coast * (3 - 2 * Coast) : 1"
				}
			]
		},
		{
			"id": "body-elevation-high",
			"type": "Formula",
			"x": 300,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "saturate((Value - 0.15) / (0.6 - 0.15))"
				}
			]
		},
		{
			"id": "body-elevation-elevation",
			"type": "Formula",
			"x": 580,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "Above <= 0 ? Base : Base + (Folds * Folds * (High * High * (3 - 2 * High)) * Height * 0.9 + (Hills - 0.5) * Height * 0.08 + (Bumps - 0.5) * Height * 0.012) * Above"
				}
			]
		},
		{
