					"key": "Name",
					"value": "YearDays"
				}
			]
		},
		{
			"id": "season-input-dayofyear",
			"type": "Input",
			"x": 0,
			"y": 400,
			"properties": [
				{
					"key": "Name",
					"value": "DayOfYear"
				}
			]
		},
		{
			"id": "season-far",
			"type": "Formula",
			"x": 300,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "HasLatitude < 0.5 ? 0.75 : saturate((abs(Latitude) - 15) / 20)"
				}
			]
		},
		{
			"id": "season-south",
			"type": "Formula",
			"x": 600,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "HasLatitude > 0.5 && Latitude < 0 ? -1 : 1"
				}
			]
		},
		{
			"id": "season-phase",
			"type": "Formula",
			"x": 900,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "(DayOfYear - YearDays * 172 / 365) / YearDays * 3.141592653589793 * 2"
				}
			]
		},
		{
			"id": "season-warmth",
			"type": "Formula",
			"x": 300,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "Fixed > 3.5 ? -1 : Fixed > 2.5 ? -0.35 : Fixed > 1.5 ? 1 : Fixed > 0.5 ? -0.3 : cos(Phase) * South * Far + (1 - Far) * 0.6"
				}
			]
		},
		{
			"id": "season-rising",
			"type": "Formula",
			"x": 600,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "Fixed > 2.5 ? 0 : Fixed > 0.5 ? 1 : sin(Phase) * South < 0 ? 1 : 0"
				}
			]
		},
		{
			"id": "season-cold",
			"type": "Formula",
			"x": 900,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "HasLatitude < 0.5 ? 0.7 : saturate((abs(Latitude) - 30) / 20)"
				}
			]
		},
		{
			"id": "season-turnv",
			"type": "Formula",
			"x": 300,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "Rising > 0.5 ? 0 : Autumn"
				}
			]
		},
		{
			"id": "season-blossomv",
			"type": "Formula",
			"x": 600,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "Rising > 0.5 ? Spring * SpringEnd : 0"
				}
			]
		},
		{
			"id": "season-dryv",
			"type": "Formula",
			"x": 900,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "Summer * 0.3 + (Rising > 0.5 ? 0 : Fall * 0.4)"
				}
			]
		},
		{
			"id": "season-snowv",
			"type": "Formula",
			"x": 300,
			"y": 640,
			"properties": [
				{
					"key": "Expression",
					"value": "Winter * Cold"
				}
			]
		},
