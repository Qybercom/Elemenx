			"x": 580,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "sqrt(X * X + Y * Y + Z * Z)"
				}
			]
		},
		{
			"id": "galaxy-density-discv",
			"type": "Formula",
			"x": 840,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "Local / exp(-0.54 * Radius / Disc) * exp(-Rad / Disc) * exp(-abs(Y) / Height)"
				}
			]
		},
		{
			"id": "galaxy-density-bulgev",
			"type": "Formula",
			"x": 1100,
			"y": 40,
			"properties": [
				{
					"key": "Expression",
					"value": "3 * exp(-sqrt(X * X + Z * Z + Y * Y * 2.5) / Bulge)"
				}
			]
		},
		{
			"id": "galaxy-density-elliptical",
			"type": "Formula",
			"x": 320,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "0.01 * exp(-7.67 * (pow(max(0.000001, sqrt(X * X / (SX * SX) + Y * Y / (SZ * SZ) + Z * Z / (SY * SY)) / (Radius * 0.22)), 0.25) - 1))"
				}
			]
		},
		{
			"id": "galaxy-density-dwarf",
			"type": "Formula",
			"x": 580,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "0.02 * pow(1 + R * R / pow(Radius * 0.25, 2), -2.5)"
				}
			]
		},
		{
			"id": "galaxy-density-ringv",
			"type": "Formula",
			"x": 840,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "BulgeV * 0.5 + Local * 2 * exp(-pow((Rad - Ring) / Width, 2)) * exp(-abs(Y) / Height)"
				}
			]
		},
		{
			"id": "galaxy-density-irregular",
			"type": "Formula",
			"x": 1100,
			"y": 240,
			"properties": [
				{
					"key": "Expression",
					"value": "DiscV * (0.3 + 1.7 * Clumps) + BulgeV * 0.05"
				}
			]
		},
		{
			"id": "galaxy-density-barred",
			"type": "Formula",
			"x": 320,
			"y": 440,
			"properties": [
				{
					"key": "Expression",
					"value": "DiscV * Arm + BulgeV + exp(-pow(Along / Bar, 2) - pow(Across / (Bar * 0.18), 2) - pow(Y / (Bar * 0.15), 2)) * 1.5"
				}
			]
		},
		{
			"id": "galaxy-density-lenticular",
