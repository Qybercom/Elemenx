<idea-plugin>
	<id>com.qybercom.elemenx</id>
	<!-- The name, the vendor and the description come from editors/extension.json (build.gradle.kts). -->

	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.xml</depends>
	<depends>com.redhat.devtools.lsp4ij</depends>

	<!--
		The inspections of HTML kept quiet on the Components and the bindings of Elemenx; their colors (Settings → Editor →
		Color Scheme → Elemenx); JavaScript in their expressions and HTML in the $Template of a definition.
	-->
	<extensions defaultExtensionNs="com.intellij">
		<lang.inspectionSuppressor language="HTML" implementationClass="com.qybercom.elemenx.ElemenxInspectionSuppressor" />
		<annotator language="HTML" implementationClass="com.qybercom.elemenx.ElemenxAnnotator" />
		<colorSettingsPage implementation="com.qybercom.elemenx.ElemenxColorSettingsPage" />
		<!-- Colors of their own in the light and the dark schemes: the ones of the theme (a class name...) were plain text in IntelliJ Light. -->
		<additionalTextAttributes scheme="Default" file="colorSchemes/ElemenxDefault.xml" />
		<additionalTextAttributes scheme="Darcula" file="colorSchemes/ElemenxDarcula.xml" />
		<multiHostInjector implementation="com.qybercom.elemenx.ElemenxInjector" />
		<!-- A name of an expression goes to the member of its Component, not to the parameter of the wrapping. -->
		<gotoDeclarationHandler implementation="com.qybercom.elemenx.ElemenxGotoDeclaration" />
		<!-- A Component is an element of its own, not the tag of HTML of its name (<Input> is no <input>). -->
		<xml.elementDescriptorProvider implementation="com.qybercom.elemenx.ElemenxElementDescriptorProvider" />
	</extensions>

	<extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
		<server id="elemenx" name="Elemenx" factoryClass="com.qybercom.elemenx.ElemenxLanguageServerFactory">
			<description><![CDATA[The language server of Elemenx: the templates and the code of an Elemenx project.]]></description>
		</server>

		<fileNamePatternMapping patterns="*.html;*.htm" serverId="elemenx" languageId="html" />
		<fileNamePatternMapping patterns="*.js;*.mjs" serverId="elemenx" languageId="javascript" />
	</extensions>
</idea-plugin>
