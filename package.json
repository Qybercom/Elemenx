{
	"name": "elemenx",
	"version": "1.0.0",
	"description": "Elemenx browser UI framework",
	"main": "elemenx.js",
	"files": [
		"elemenx.js",
		"README.md",
		"LICENSE",
		"tools",
		"examples"
	],
	"scripts": {
		"test": "npm run test:browser && npm run test:history",
		"test:browser": "vitest run",
		"test:watch": "vitest",
		"test:history": "playwright test",
		"examples": "vite --host 127.0.0.1",
		"example:simple": "node tools/server.js examples/Simple 4174",
		"example:advanced": "node tools/builder.js dev examples/Advanced --port 4173",
		"build:advanced": "node tools/builder.js build examples/Advanced",
		"example:advanced:dist": "node tools/builder.js serve examples/Advanced/dist --port 4175"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@vitest/browser-playwright": "5.0.1",
		"playwright": "1.63.0",
		"vite": "7.3.6",
		"vitest": "5.0.1"
	}
}