{
	"name": "@qybercom/elemenx",
	"version": "0.9.1",
	"description": "A browser UI framework in one ES5 file: components, reactive state, routing, services, storage, messaging and network, with its CLI and the ElemenxUI component library",
	"keywords": [
		"ui",
		"framework",
		"components",
		"ui-kit",
		"router",
		"reactive",
		"spa",
		"es5",
		"no-build",
		"cli"
	],
	"homepage": "https://github.com/Qybercom/Elemenx#readme",
	"bugs": {
		"url": "https://github.com/Qybercom/Elemenx/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Qybercom/Elemenx.git"
	},
	"license": "LGPL-3.0-only",
	"author": "Alex Furnica",
	"main": "elemenx.js",
	"unpkg": "dist/elemenx.min.js",
	"jsdelivr": "dist/elemenx.min.js",
	"bin": {
		"elemenx": "elemenx-cli.js"
	},
	"files": [
		"elemenx.js",
		"elemenx-cli.js",
		"README.md",
		"LICENSE",
		"docs",
		"tools",
		"libraries",
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "npm run lint && npm run test:browser && npm run test:tools && npm run dist && npm run test:min && npm run test:history",
		"dist": "node tools/dist.js",
		"test:min": "node tests/dist/min.mjs",
		"test:browser": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:all": "node tests/coverage/run.mjs",
		"test:history": "playwright test",
		"examples": "vite --host 127.0.0.1",
		"example:simple": "node elemenx-cli.js dev examples/Simple --port 4174",
		"example:advanced": "node elemenx-cli.js dev examples/Advanced",
		"build:advanced": "node elemenx-cli.js build examples/Advanced",
		"example:advanced:dist": "node elemenx-cli.js serve examples/Advanced",
		"test:tools": "vitest run --config vitest.node.config.mjs",
		"lint": "eslint && stylelint \"**/*.{css,html}\"",
		"prepack": "npm run dist",
		"preversion": "node scripts/version.js check",
		"version": "node scripts/version.js sync && git add packages/elemenx/package.json",
		"version:set": "node scripts/version.js set",
		"version:tag": "node scripts/version.js tag"
	},
	"devDependencies": {
		"@html-eslint/eslint-plugin": "0.66.1",
		"@html-eslint/parser": "0.66.1",
		"@playwright/test": "1.63.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@stylistic/stylelint-plugin": "5.3.1",
		"@vitest/browser-playwright": "5.0.1",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/istanbul-lib-coverage": "1.0.2",
		"@vitest/istanbul-lib-report": "1.0.2",
		"ast-v8-to-istanbul": "1.0.7",
		"eslint": "10.12.0",
		"eslint-plugin-html": "8.2.1",
		"eslint-scope": "9.1.2",
		"espree": "11.2.0",
		"playwright": "1.63.0",
		"postcss-html": "2.0.0",
		"stylelint": "17.16.0",
		"vite": "7.3.6",
		"vitest": "5.0.1"
	}
}
